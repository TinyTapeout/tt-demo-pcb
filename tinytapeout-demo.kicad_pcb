	(gr_text "(C) 2025 TinyTapeout"
		(at 109.5 39.1 0)
		(layer "B.SilkS")
		(uuid "dad56c3b-9e2f-4cc1-8632-95856dd9449d")
		(effects
			(font
				(size 1.2 1)
				(thickness 0.2)
				(bold yes)
			)
			(justify bottom mirror)
		)
	)
	(gr_text "The Tiny Tapeout demoboard features new more better connectors \nand is now powered by an RP2350 for a lot more RP2 crunch. \n\nInsert a breakout with your ASIC, or get testing while the \nfoundry does its thing using an FPGA breakout.\n\nTo update the SDK, hold the BOOT button, up top, while plugging into the \ncomputer's USB port.  A drive will appear on which to drop the UF2 file."
		(at 109.5 67.2 0)
		(layer "B.SilkS")
		(uuid "9993dd67-33bd-483f-bd13-03c20ab53784")
		(effects
			(font
				(size 1.5 1.15)
				(thickness 0.175)
			)
			(justify bottom mirror)
		)
	)
